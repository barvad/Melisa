<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>7ff16ff4-a947-45e2-b7f0-e61eb2b5526b</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CXuesong.MW.WikiClientLibrary" Version="0.9.0-int.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.11" />
    <PackageReference Include="Microsoft.ML" Version="3.0.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.12.2" />
    <PackageReference Include="Microsoft.ML.OnnxTransformer" Version="3.0.1" />    
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="0.22.0" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.2.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="Refit" Version="10.0.1" />
    <PackageReference Include="Refit.HttpClientFactory" Version="10.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="8.1.4" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="8.1.4" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="8.1.4" />
    <PackageReference Include="Tokenizers.DotNet" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Practicum.MelisaBot.Ef\Practicum.MelisaBot.Ef.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="PromtTemplate.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="DownloadModelFiles" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <ModelDir>$(ProjectDir)Models\</ModelDir>
      <ModelUrl>https://huggingface.co/Xenova/distiluse-base-multilingual-cased-v2/resolve/main/onnx/model.onnx</ModelUrl>
      <VocabUrl>https://huggingface.co/Xenova/distiluse-base-multilingual-cased-v2/resolve/main/vocab.txt</VocabUrl>
    </PropertyGroup>

    <MakeDir Directories="$(ModelDir)" Condition="!Exists('$(ModelDir)')" />

    <DownloadFile SourceUrl="$(ModelUrl)" DestinationFolder="$(ModelDir)" SkipUnchangedFiles="true" Condition="!Exists('$(ModelDir)model.onnx')" />
    <DownloadFile SourceUrl="$(VocabUrl)" DestinationFolder="$(ModelDir)" SkipUnchangedFiles="true" Condition="!Exists('$(ModelDir)vocab.txt')" />

    <ItemGroup>
      <None Include="Models\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
                                                  